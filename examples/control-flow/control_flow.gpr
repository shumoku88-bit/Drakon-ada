project Control_Flow is
   for Languages use ("Ada");
   for Source_Dirs use ("../../build/control-flow/generated", ".");
   for Object_Dir use "../../build/control-flow/obj";
   for Exec_Dir use "../../build/control-flow/bin";
   for Main use ("control_flow_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwe");
   end Compiler;
end Control_Flow;
