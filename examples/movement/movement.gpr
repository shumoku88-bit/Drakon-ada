project Movement is
   for Languages use ("Ada");
   for Source_Dirs use ("../../build/generated", ".");
   for Object_Dir use "../../build/obj";
   for Exec_Dir use "../../build/bin";
   for Main use ("movement_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwe");
   end Compiler;
end Movement;
